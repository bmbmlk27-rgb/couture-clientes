# Copier ce fichier en `.env.local` (développement) ou reporter ces variables
# dans Vercel / Netlify (production). Ne jamais committer `.env.local`.

# --- Supabase (Dashboard → Project Settings → API) -----------------------
# URL du projet, ex. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Clé « anon public » (PAS la clé service_role !)
VITE_SUPABASE_ANON_KEY=

# --- Optionnel ------------------------------------------------------------
# Relais API Melbet. Par défaut /api/melbet (proxy Vite en dev, fonction
# serverless en production). À changer seulement si vous hébergez le relais ailleurs.
# VITE_API_BASE_URL=/api/melbet

# Moyenne de buts de la ligue utilisée pour normaliser le modèle (défaut 2.5).
# VITE_AVG_LEAGUE_GOALS=2.5
